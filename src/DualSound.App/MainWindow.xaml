<Window x:Class="DualSound.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DualSound.App.ViewModels"
        xmlns:views="clr-namespace:DualSound.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="DualSound – Offline Windows Audio Processor"
        Height="780" Width="1220"
        MinHeight="650" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushAppBackground}">

    <Window.Resources>
        <!-- DataTemplates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioDevicesViewModel}">
            <views:AudioDevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioRoutingViewModel}">
            <views:AudioRoutingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EqualizerViewModel}">
            <views:EqualizerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SynchronizationViewModel}">
            <views:SynchronizationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Main Shell Area: Sidebar + Content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BrushSidebarBackground}" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Brand / Logo -->
                    <Border Grid.Row="0" Padding="20,24,20,20" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource BrushAccent}" CornerRadius="8" Width="32" Height="32" Margin="0,0,12,0">
                                    <Path Data="{StaticResource IconSpeaker}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DUALSOUND" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" />
                                    <TextBlock Text="Offline Audio Processor" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Items List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavigationItemContainerStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,12,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Vector Icon -->
                                    <Path Grid.Column="0"
                                          Data="{Binding IconGeometryKey, Converter={StaticResource StringToGeom}}"
                                          Width="16" Height="16" Stretch="Uniform"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{StaticResource BrushTextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource BrushAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>

                                    <!-- Navigation Title -->
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="13" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Target Setup Hardware Card in Sidebar Footer -->
                    <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" CornerRadius="8" Padding="14,12" Margin="14,12,14,16" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="HARDWARE TOPOLOGY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource BrushHdmi}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="TV via HDMI" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource BrushAnalog}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Home Theatre (3.5mm)" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hardware Change Global Notification Bar -->
                <Border Grid.Row="0" Background="{StaticResource BrushAccentMuted}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="0,0,0,1" Padding="20,8"
                        Visibility="{Binding DeviceEventNotification, Converter={StaticResource StringToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource BrushSuccess}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding DeviceEventNotification}" Foreground="#BFDBFE" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Command="{Binding DismissNotificationCommand}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Active Page View Host -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>

        <!-- Bottom Application Status Bar -->
        <Border Grid.Row="1" Background="{StaticResource BrushHeaderBackground}" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Default Playback Device Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Default Playback: " FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                    <TextBlock Text="{Binding DefaultPlaybackDeviceName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                </StackPanel>

                <!-- Center: Active Devices count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Active Audio Endpoints: " FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                    <TextBlock Text="{Binding ActiveDevicesCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" />
                </StackPanel>

                <!-- Right: Offline Status Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconOffline}" Fill="{StaticResource BrushSuccess}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Offline Audio Engine Ready" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushSuccess}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
