<UserControl x:Class="DualSound.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DualSound.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1020">

    <Grid Margin="24,18" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Application Settings" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                    <Border Background="{StaticResource BrushAccentMuted}" CornerRadius="12" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="OFFLINE CONFIGURATION" Foreground="#93C5FD" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Manage audio engine preferences, startup behavior, and local JSON storage" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource OutlineButton}" Command="{Binding ResetToDefaultsCommand}" Height="34" Padding="14,0" Margin="0,0,8,0">
                    <TextBlock Text="Restore Defaults" />
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" Height="34" Padding="16,0">
                    <TextBlock Text="Save Preferences" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Notification Banner -->
        <Border Grid.Row="1" Background="{StaticResource BrushSuccessBg}" BorderBrush="{StaticResource BrushSuccess}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding SaveMessage, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding SaveMessage}" Foreground="#A7F3D0" FontSize="12" FontWeight="Medium" />
        </Border>

        <!-- 2. Settings Content Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Audio Engine & Startup -->
                <StackPanel Grid.Column="0">
                    <!-- Card 1: Audio Engine & DSP Performance -->
                    <Border Style="{StaticResource CardPanel}" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="AUDIO ENGINE &amp; DSP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12" />

                            <!-- Sample Rate -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Internal Processing Rate" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Canonical 48 kHz preferred for cinema" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding AvailableSampleRates}"
                                          SelectedItem="{Binding TargetSampleRate, Mode=TwoWay}"
                                          Height="30" />
                            </Grid>

                            <!-- Buffer Latency Target -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="WASAPI Buffer Latency Target" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="(Lower = less delay; Higher = stability)" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding BufferLatencyMs, StringFormat={}{0} ms}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Grid.Row="1" Minimum="20" Maximum="100" Value="{Binding BufferLatencyMs, Mode=TwoWay}" SmallChange="5" LargeChange="10" />
                            </Grid>

                            <!-- Auto Restart on Device Loss -->
                            <CheckBox Content="Auto-recover when HDMI display or 3.5 mm jack reconnects"
                                      IsChecked="{Binding AutoRestartOnDeviceLoss, Mode=TwoWay}"
                                      Style="{StaticResource ModernCheckBox}" />
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Startup Behavior -->
                    <Border Style="{StaticResource CardPanel}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="APPLICATION STARTUP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12" />

                            <CheckBox Content="Automatically start dual audio engine on application launch"
                                      IsChecked="{Binding AutoStartEngine, Mode=TwoWay}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10" />

                            <CheckBox Content="Start minimized to Windows taskbar"
                                      IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                      Style="{StaticResource ModernCheckBox}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Hardware Discovery & Local Storage -->
                <StackPanel Grid.Column="2">
                    <!-- Card 3: Windows Device Discovery -->
                    <Border Style="{StaticResource CardPanel}" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="DEVICE DISCOVERY &amp; MONITORING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12" />

                            <CheckBox Content="Real-time CoreAudio plug and play monitoring"
                                      IsChecked="{Binding AutoRefreshDevices, Mode=TwoWay}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10" />

                            <CheckBox Content="Display disconnected or unplugged hardware endpoints"
                                      IsChecked="{Binding ShowDisconnectedDevices, Mode=TwoWay}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10" />

                            <CheckBox Content="Display disabled Windows audio endpoints"
                                      IsChecked="{Binding ShowDisabledDevices, Mode=TwoWay}"
                                      Style="{StaticResource ModernCheckBox}" />
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Local Storage & Diagnostics -->
                    <Border Style="{StaticResource CardPanel}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="LOCAL STORAGE &amp; DIAGNOSTICS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12" />

                            <!-- Diagnostic Log Level -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Minimum Log Level" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Stored offline in LocalAppData" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding AvailableLogLevels}"
                                          SelectedItem="{Binding MinimumLogLevel, Mode=TwoWay}"
                                          Height="30" />
                            </Grid>

                            <!-- Settings File Location -->
                            <TextBlock Text="CONFIG FILE PATH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding SettingsFilePath}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                            <Button Style="{StaticResource OutlineButton}" Command="{Binding OpenSettingsDirectoryCommand}" Height="30" Padding="12,0" HorizontalAlignment="Left">
                                <TextBlock Text="Open Config Folder" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>
