<UserControl x:Class="DualSound.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DualSound.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" MaxWidth="850" HorizontalAlignment="Left">

            <!-- Title & Subtitle -->
            <TextBlock Text="Application Settings" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Manage local application preferences, device detection behavior, and storage" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,24" />

            <!-- Success / Confirmation Banner -->
            <Border Background="{StaticResource BrushSuccessBg}" BorderBrush="{StaticResource BrushSuccess}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,20"
                    Visibility="{Binding SaveMessage, Converter={StaticResource StringToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconCheck}" Fill="{StaticResource BrushSuccess}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SaveMessage}" Foreground="#A7F3D0" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Error Banner -->
            <Border Background="{StaticResource BrushDangerBg}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,20"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconWarning}" Fill="{StaticResource BrushDanger}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#FECACA" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Device Enumeration & Discovery Section -->
            <TextBlock Text="AUDIO ENDPOINT DISCOVERY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10" />
            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Auto-refresh Toggle -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Live Device Detection" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Automatically detect newly connected or unplugged audio endpoints in real time" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ModernCheckBox}" IsChecked="{Binding AutoRefreshDevices}" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BrushSurfaceBorderSubtle}" Margin="0,0,0,16" />

                    <!-- Show Disconnected Devices -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Show Disconnected &amp; Unplugged Endpoints" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Display 3.5mm jacks and USB devices that are currently unplugged or not present" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ModernCheckBox}" IsChecked="{Binding ShowDisconnectedDevices}" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BrushSurfaceBorderSubtle}" Margin="0,0,0,16" />

                    <!-- Show Disabled Devices -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Show Disabled Endpoints" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Include endpoints that have been disabled in Windows Sound Settings" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ModernCheckBox}" IsChecked="{Binding ShowDisabledDevices}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Storage & Offline Mode Section -->
            <TextBlock Text="OFFLINE STORAGE &amp; PRIVACY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10" />
            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Local Configuration File" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Settings are stored locally as JSON in your Windows AppData directory" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Command="{Binding OpenSettingsFolderCommand}" Content="Open Folder" VerticalAlignment="Center" />
                    </Grid>

                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SettingsFilePath, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,0,0,12" />

                    <!-- Offline Guarantee Card -->
                    <Border Background="{StaticResource BrushSidebarBackground}" CornerRadius="6" Padding="14,12" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconOffline}" Fill="{StaticResource BrushSuccess}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Strictly Offline Architecture" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushSuccess}" />
                                <TextBlock Text="DualSound never initiates internet connections or sends telemetry. In accordance with audio processing standards, temporary audio buffers are never saved to disk."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bottom Save / Reset Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" Margin="0,0,12,0">
                    <TextBlock Text="Save Preferences" />
                </Button>
                <Button Style="{StaticResource OutlineButton}" Command="{Binding ResetToDefaultsCommand}">
                    <TextBlock Text="Reset Defaults" />
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>

