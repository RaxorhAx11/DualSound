<UserControl x:Class="DualSound.App.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DualSound.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SetupWizardViewModel}"
             d:DesignHeight="720" d:DesignWidth="1020">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <!-- Header & Step Tracker -->
            <RowDefinition Height="Auto" />
            <!-- Step Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer Navigation Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: Title & Multi-Step Progress Tracker -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SYSTEM-WIDE AUDIO SETUP WIZARD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding ExitWizardCommand}" Style="{StaticResource OutlineButton}" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Skip to Dashboard" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Step Tracker Pills -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 Pill -->
                    <Border Grid.Column="0" Height="4" Margin="2,0" CornerRadius="2"
                            Background="{Binding CurrentStep, Converter={StaticResource StepToBrush}, ConverterParameter=1}" />
                    <!-- Step 2 Pill -->
                    <Border Grid.Column="1" Height="4" Margin="2,0" CornerRadius="2"
                            Background="{Binding CurrentStep, Converter={StaticResource StepToBrush}, ConverterParameter=2}" />
                    <!-- Step 3 Pill -->
                    <Border Grid.Column="2" Height="4" Margin="2,0" CornerRadius="2"
                            Background="{Binding CurrentStep, Converter={StaticResource StepToBrush}, ConverterParameter=3}" />
                    <!-- Step 4 Pill -->
                    <Border Grid.Column="3" Height="4" Margin="2,0" CornerRadius="2"
                            Background="{Binding CurrentStep, Converter={StaticResource StepToBrush}, ConverterParameter=4}" />
                    <!-- Step 5 Pill -->
                    <Border Grid.Column="4" Height="4" Margin="2,0" CornerRadius="2"
                            Background="{Binding CurrentStep, Converter={StaticResource StepToBrush}, ConverterParameter=5}" />
                    <!-- Step 6 Pill -->
                    <Border Grid.Column="5" Height="4" Margin="2,0" CornerRadius="2"
                            Background="{Binding CurrentStep, Converter={StaticResource StepToBrush}, ConverterParameter=6}" />
                    <!-- Step 7 Pill -->
                    <Border Grid.Column="6" Height="4" Margin="2,0" CornerRadius="2"
                            Background="{Binding CurrentStep, Converter={StaticResource StepToBrush}, ConverterParameter=7}" />
                </Grid>
            </Grid>
        </Border>

        <!-- MAIN STEP CONTENT AREA -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <Grid>

                <!-- ================= STEP 1: WELCOME & VIRTUAL CABLE ================= -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=1}" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Welcome to DualSound" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" LineHeight="20">
                                DualSound captures system-wide Windows desktop audio (YouTube, Chrome, media players, games) and distributes it simultaneously to two independent physical audio endpoints:
                            </TextBlock>
                            <StackPanel Margin="0,10,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushHdmi}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="TV / HDMI: Normal, crystal-clear movie and dialogue audio." FontSize="13" Foreground="{StaticResource BrushTextPrimary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushAnalog}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Home Theatre / 3.5 mm: Enhanced dialogue clarity and synchronized deep bass." FontSize="13" Foreground="{StaticResource BrushTextPrimary}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Virtual Audio Driver Detection Card -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Virtual Audio Cable Detection" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding RefreshDiagnosticsCommand}" Style="{StaticResource OutlineButton}" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconScan}" Fill="{StaticResource BrushTextSecondary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Scan Again" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Background="{StaticResource BrushAppBackground}" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                            Background="{Binding IsVirtualCableInstalled, Converter={StaticResource StateToBrush}}"
                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconRouting}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="VB-Audio Virtual Cable Status" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding VirtualCableStatusText}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="8,4" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{Binding IsVirtualCableInstalled, Converter={StaticResource StateToBrush}}">
                                        <TextBlock Text="{Binding IsVirtualCableInstalled, Converter={StaticResource StateToBrush}}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Offline Installation Guidance -->
                            <StackPanel Visibility="{Binding IsVirtualCableInstalled, Converter={StaticResource InverseBoolToVis}}" Margin="0,14,0,0">
                                <TextBlock Text="Offline Installation Guide:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushWarning}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" LineHeight="18">
                                    A virtual audio cable provides an isolated sink for Windows audio. To install offline:&#x0a;
                                    1. Download VB-Audio Virtual Cable driver (e.g. VBCABLE_Driver_Pack43.zip).&#x0a;
                                    2. Extract and run VBCABLE_Setup_x64.exe as Administrator.&#x0a;
                                    3. Click 'Install Driver' and return to DualSound.
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= STEP 2: SOURCE DISCOVERY ================= -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=2}" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Audio Source &amp; Capture Endpoint" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,14" LineHeight="20">
                                DualSound captures system sound from the virtual recording endpoint (CABLE Output). When applications play sound to CABLE Input, it arrives cleanly here without feedback loops.
                            </TextBlock>

                            <!-- Detected Virtual Playback Endpoint -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Virtual Playback Endpoint:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource BrushAppBackground}" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                    <TextBlock Text="{Binding DetectedVirtualPlayback.Name, FallbackValue='CABLE Input (VB-Audio Virtual Cable)'}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
                                </Border>
                            </Grid>

                            <!-- Selected Recording Capture Endpoint -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Recording Capture Endpoint:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding AvailableCaptureDevices}"
                                          SelectedItem="{Binding SelectedCaptureDevice, Mode=TwoWay}"
                                          Height="32">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Border Background="{StaticResource BrushAppBackground}" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSync}" Fill="{StaticResource BrushAccent}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="DualSound automatically converts 44.1 kHz, 48 kHz, 96 kHz capture streams to 32-bit float internal processing." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= STEP 3: WINDOWS AUDIO ROUTING ================= -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=3}" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Configure Windows Default Playback" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,14" LineHeight="20">
                                To send all Windows desktop audio (browsers, media players, games) into DualSound, set your Windows default playback device to your virtual cable playback endpoint.
                            </TextBlock>

                            <!-- Current Default Endpoint Status Banner -->
                            <Border Background="{StaticResource BrushAppBackground}" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                            Background="{Binding IsDefaultPlaybackCorrect, Converter={StaticResource StateToBrush}}"
                                            Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSpeaker}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Current Windows Default Playback Endpoint:" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Text="{Binding CurrentDefaultPlaybackDevice.Name, FallbackValue='None'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,1,0,0" />
                                        <TextBlock Text="{Binding RoutingStatusMessage}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding RefreshDiagnosticsCommand}" Style="{StaticResource OutlineButton}" Padding="10,6" VerticalAlignment="Center">
                                        <TextBlock Text="Verify Now" FontSize="11" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Instruction & Windows Sound Settings Launcher -->
                            <Border Background="{StaticResource BrushCardBackgroundHover}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="One-Click Guided Configuration" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Per Microsoft guidelines, default audio endpoints are set by the user via Windows Settings. Click the button to open Windows Sound Settings and choose 'CABLE Input'." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding OpenWindowsSoundSettingsCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSettings}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Open Sound Settings" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= STEP 4: PHYSICAL OUTPUTS ================= -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=4}" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Assign Physical Playback Outputs" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,14" LineHeight="20">
                                Select the two physical audio outputs connected to your computer. DualSound sends audio to both devices simultaneously with dedicated DSP.
                            </TextBlock>

                            <!-- Output 1: TV HDMI -->
                            <Border Background="{StaticResource BrushAppBackground}" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrushHdmi}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="OUTPUT 1: TV (HDMI / DISPLAYPORT)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushHdmi}" />
                                    </StackPanel>
                                    <ComboBox Grid.Row="1"
                                              Style="{StaticResource ModernComboBox}"
                                              ItemsSource="{Binding AvailablePlaybackDevices}"
                                              SelectedItem="{Binding SelectedTvDevice, Mode=TwoWay}"
                                              Height="34">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DeviceTypeDescription}" FontSize="10" Foreground="{Binding DeviceType, Converter={StaticResource TypeToBrush}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Output 2: Home Theatre 3.5mm -->
                            <Border Background="{StaticResource BrushAppBackground}" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrushAnalog}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="OUTPUT 2: HOME THEATRE (3.5 MM / SPEAKERS)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAnalog}" />
                                    </StackPanel>
                                    <ComboBox Grid.Row="1"
                                              Style="{StaticResource ModernComboBox}"
                                              ItemsSource="{Binding AvailablePlaybackDevices}"
                                              SelectedItem="{Binding SelectedHomeTheatreDevice, Mode=TwoWay}"
                                              Height="34">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DeviceTypeDescription}" FontSize="10" Foreground="{Binding DeviceType, Converter={StaticResource TypeToBrush}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Validation Message Strip -->
                            <TextBlock Text="{Binding OutputsValidationMessage}" FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding AreOutputsValid, Converter={StaticResource StateToBrush}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= STEP 5: CAPABILITY PROBE ================= -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=5}" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Permission &amp; Pipeline Readiness Probe" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,14" LineHeight="20">
                                DualSound verifies that all required Windows audio endpoints can be initialized in shared mode without elevation or access denial.
                            </TextBlock>

                            <!-- Checklist -->
                            <StackPanel Margin="0,0,0,16">
                                <Border Background="{StaticResource BrushAppBackground}" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding IsCaptureProbeSuccess, Converter={StaticResource StateToBrush}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Virtual Cable Recording Endpoint Probe" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding IsCaptureProbeSuccess, Converter={StaticResource StateToBrush}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource BrushAppBackground}" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding IsTvProbeSuccess, Converter={StaticResource StateToBrush}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Output 1: TV (HDMI) Playback Access" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding IsTvProbeSuccess, Converter={StaticResource StateToBrush}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource BrushAppBackground}" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding IsHomeTheatreProbeSuccess, Converter={StaticResource StateToBrush}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Output 2: Home Theatre (3.5 mm) Playback Access" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding IsHomeTheatreProbeSuccess, Converter={StaticResource StateToBrush}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding ReadinessStatusMessage}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= STEP 6: SAFE TEST TONE ================= -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=6}" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Safe Acoustic Test Tone" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,14" LineHeight="20">
                                Verify audio rendering through each physical device. Test tones are studio-grade -12 dBFS sine waves with 50 ms cosine window ramp-up and ramp-down to eliminate speaker pops and clicks.
                            </TextBlock>

                            <!-- Test Buttons Grid -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding TestTvToneCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Padding="14,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconSpeaker}" Fill="{StaticResource BrushHdmi}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        <TextBlock Text="Test TV (HDMI)" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Command="{Binding TestHomeTheatreToneCommand}" Style="{StaticResource OutlineButton}" Margin="4,0" Padding="14,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconSpeaker}" Fill="{StaticResource BrushAnalog}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        <TextBlock Text="Test Home Theatre" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding TestBothTonesCommand}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Padding="14,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconRouting}" Fill="{StaticResource BrushAccent}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        <TextBlock Text="Test Both Outputs" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Tone Feedback Status -->
                            <Border Background="{StaticResource BrushAppBackground}" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ActiveToneTarget}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding StopTestToneCommand}" Style="{StaticResource DangerButton}" Padding="10,4"
                                            Visibility="{Binding IsPlayingTone, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Stop Test" FontSize="11" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= STEP 7: COMPLETE SETUP ================= -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=7}" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Setup Complete &amp; Ready to Launch" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,16" LineHeight="20">
                                Your dual-output configuration has been verified. DualSound will remember these device selections across system restarts.
                            </TextBlock>

                            <!-- Summary Box -->
                            <Border Background="{StaticResource BrushAppBackground}" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Capture Source:" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedCaptureDevice.Name, FallbackValue='CABLE Output'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Output 1 (TV):" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedTvDevice.Name, FallbackValue='TV HDMI'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushHdmi}" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Output 2 (Home Theatre):" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedHomeTheatreDevice.Name, FallbackValue='Home Theatre 3.5mm'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAnalog}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Auto-Start Checkbox -->
                            <CheckBox IsChecked="{Binding StartEngineOnFinish, Mode=TwoWay}" Margin="0,0,0,16">
                                <TextBlock Text="Start DualSound Audio Engine immediately on completion" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" Margin="6,0,0,0" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- BOTTOM NAVIGATION BAR -->
        <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Previous Step -->
                <Button Grid.Column="0" Command="{Binding PreviousStepCommand}" Style="{StaticResource OutlineButton}" Padding="16,8" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2190; Back" FontSize="13" />
                    </StackPanel>
                </Button>

                <!-- Next Step (Steps 1 to 6) -->
                <Button Grid.Column="1" Command="{Binding NextStepCommand}" Padding="20,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="7">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Next Step &#x2192;" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Complete Setup (Step 7 only) -->
                <Button Grid.Column="2" Command="{Binding CompleteSetupCommand}" Padding="20,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="7">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Complete Setup &amp; Launch" FontSize="13" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>
