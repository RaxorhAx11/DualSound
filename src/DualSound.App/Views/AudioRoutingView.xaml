<UserControl x:Class="DualSound.App.Views.AudioRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DualSound.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:AudioRoutingViewModel}"
             d:DesignHeight="720" d:DesignWidth="1020">

    <UserControl.Resources>
        <Style x:Key="VuMeterBarStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushSurfaceBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#10B981" Offset="0.0" />
                                            <GradientStop Color="#10B981" Offset="0.7" />
                                            <GradientStop Color="#F59E0B" Offset="0.85" />
                                            <GradientStop Color="#EF4444" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Audio Routing &amp; Distribution Matrix" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                    <Border Background="{StaticResource BrushAccentMuted}" CornerRadius="12" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CAPTURE &amp; DUAL OUTPUT" Foreground="#93C5FD" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Captures live audio from virtual audio cables (e.g. CABLE Output) and routes to independent physical outputs" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource OutlineButton}"
                        Command="{Binding RefreshAllDevicesCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                        Height="34" Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Scan Audio Devices" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status / Error Notification Banner -->
        <Border Grid.Row="1" Background="{StaticResource BrushAccentMuted}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding StatusBannerMessage, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding StatusBannerMessage}" Foreground="#BFDBFE" FontSize="12" FontWeight="Medium" />
        </Border>

        <!-- 2. Main Content Grid (Two Columns: Left = Routing Controls; Right = Live VU Monitor) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: Routing Controls (Capture Source + Dual Outputs) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <!-- Card 1: Capture Source Selection & Controls -->
                    <Border Style="{StaticResource CardPanel}" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconRouting}" Fill="{StaticResource BrushAccent}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="1. CAPTURE SOURCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                    <TextBlock Text="Windows Recording Endpoint (e.g. CABLE Output)" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource BrushCardBackgroundHover}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CaptureStatusText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                                </Border>
                            </Grid>

                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding AvailableRecordingDevices}"
                                      SelectedItem="{Binding SelectedRecordingDevice, Mode=TwoWay}"
                                      Height="32" Margin="0,0,0,10">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding DeviceTypeDescription}" FontSize="10" Foreground="{Binding DeviceType, Converter={StaticResource TypeToBrush}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Start / Stop Controls -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Command="{Binding StartCaptureCommand}" IsEnabled="{Binding CanStartCapture}" Height="32">
                                    <TextBlock Text="Start Capture Engine" />
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Command="{Binding StopCaptureCommand}" IsEnabled="{Binding CanStopCapture}" Height="32">
                                    <TextBlock Text="Stop Capture Engine" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Simultaneous Dual Output Destinations -->
                    <Border Style="{StaticResource CardPanel}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="2. OUTPUT DISTRIBUTION BRANCHES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10" />

                            <!-- Branch A: TV / HDMI -->
                            <Border Background="{StaticResource BrushSidebarBackground}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="TV (HDMI) Branch" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushHdmi}" />
                                        <CheckBox Content="Enabled" IsChecked="{Binding IsTvEnabled, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <ComboBox Style="{StaticResource ModernComboBox}"
                                              ItemsSource="{Binding AvailablePlaybackDevices}"
                                              SelectedItem="{Binding SelectedTvDevice, Mode=TwoWay}"
                                              Height="30" Margin="0,0,0,8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Volume Slider & Peak Readout -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Vol" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding TvVolume, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding TvVolume, StringFormat={}{0:P0}}" FontSize="10" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding TvPeakDbfs}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushHdmi}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Branch B: Home Theatre / 3.5 mm -->
                            <Border Background="{StaticResource BrushSidebarBackground}" CornerRadius="6" Padding="12,10" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Home Theatre (3.5 mm) Branch" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAnalog}" />
                                        <CheckBox Content="Enabled" IsChecked="{Binding IsHomeTheatreEnabled, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <ComboBox Style="{StaticResource ModernComboBox}"
                                              ItemsSource="{Binding AvailablePlaybackDevices}"
                                              SelectedItem="{Binding SelectedHomeTheatreDevice, Mode=TwoWay}"
                                              Height="30" Margin="0,0,0,8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Volume Slider & Peak Readout -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Vol" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding HomeTheatreVolume, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding HomeTheatreVolume, StringFormat={}{0:P0}}" FontSize="10" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding HomeTheatrePeakDbfs}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAnalog}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT PANE: Live Studio VU Meter Monitor -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="LIVE CAPTURE MONITOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding HasSignal, Converter={StaticResource StateToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SignalStatusText}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Dual VU Bars (Left & Right) -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <!-- Left Channel -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="LEFT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding FormattedLeftPeak}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Style="{StaticResource VuMeterBarStyle}" Value="{Binding LeftMeterLevel}" Margin="0,0,0,10" />

                        <!-- Right Channel -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="RIGHT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding FormattedRightPeak}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Style="{StaticResource VuMeterBarStyle}" Value="{Binding RightMeterLevel}" />
                    </StackPanel>

                    <!-- Peak Level Readout -->
                    <Border Grid.Row="2" Background="{StaticResource BrushSidebarBackground}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MASTER INPUT PEAK" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding FormattedMasterPeak}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource BrushCardBackgroundHover}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="48 kHz • 32-bit" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Stream Telemetry Statistics -->
                    <Border Grid.Row="3" Background="{StaticResource BrushSidebarBackground}" CornerRadius="6" Padding="14,10" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                <TextBlock Text="SOURCE SAMPLE RATE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding FormattedSampleRate}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,1,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                <TextBlock Text="CHANNELS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding FormattedChannels}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,1,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="RING BUFFER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding FormattedBufferOccupancy}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,1,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="TOTAL FRAMES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding TotalFramesCaptured, StringFormat={}{0:N0}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
