<UserControl x:Class="DualSound.App.Views.AudioRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DualSound.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:AudioRoutingViewModel}"
             d:DesignHeight="700" d:DesignWidth="1050">

    <UserControl.Resources>
        <!-- High-Precision Studio Audio Meter Bar Style -->
        <Style x:Key="StudioMeterBarStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushSurfaceBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#10B981" Offset="0.0" />
                                            <GradientStop Color="#22D3EE" Offset="0.65" />
                                            <GradientStop Color="#F59E0B" Offset="0.85" />
                                            <GradientStop Color="#EF4444" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Buffer Health Bar Style -->
        <Style x:Key="BufferHealthBarStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushSurfaceBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource BrushAccent}"
                                        CornerRadius="2" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Real-Time Audio Capture Engine" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                    <Border Background="{StaticResource BrushAccentMuted}" CornerRadius="12" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MILESTONE 02 • ACTIVE" Foreground="#93C5FD" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Captures live audio from virtual audio cables (e.g. CABLE Output) or hardware inputs" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource OutlineButton}"
                        Command="{Binding RefreshRecordingDevicesCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                        Height="34" Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Scan Recording Devices" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status / Error Notification Banner -->
        <Border Grid.Row="1" Background="{StaticResource BrushAccentMuted}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="6" Padding="14,9" Margin="0,0,0,16"
                Visibility="{Binding StatusBannerMessage, Converter={StaticResource StringToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource BrushSuccess}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusBannerMessage}" Foreground="#BFDBFE" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 2. Main Content Grid (Two Columns: Left = Source & Controls; Right = Live VU Monitor) -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="400" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: Capture Source & Controls -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card A: Capture Source Selection & Device Info -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="18,16">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRouting}" Fill="{StaticResource BrushAccent}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="CAPTURE SOURCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="Select Windows Recording Endpoint" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                            </StackPanel>

                            <!-- Default Indicator Badge -->
                            <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                    Background="{StaticResource BrushAccentMuted}"
                                    Visibility="{Binding SelectedRecordingDevice.IsDefaultRecording, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="DEFAULT RECORDING" Foreground="#93C5FD" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Separator Background="{StaticResource BrushSurfaceBorderSubtle}" Margin="0,0,0,12" />

                        <!-- Device Dropdown -->
                        <TextBlock Text="RECORDING ENDPOINT (e.g. CABLE Output)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableRecordingDevices}"
                                  SelectedItem="{Binding SelectedRecordingDevice, Mode=TwoWay}"
                                  Height="34" Margin="0,0,0,14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding DeviceTypeDescription}" FontSize="10" Foreground="{Binding DeviceType, Converter={StaticResource TypeToBrush}}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Hardware Properties Grid -->
                        <Grid Margin="0,0,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="CONNECTION TYPE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding SelectedRecordingDevice.DeviceTypeDescription, FallbackValue='Not identified'}"
                                           FontSize="12" FontWeight="Medium" Foreground="{Binding SelectedRecordingDevice.DeviceType, Converter={StaticResource TypeToBrush}}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="ENDPOINT STATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding SelectedRecordingDevice.StateDescription, FallbackValue='No device'}"
                                           FontSize="12" FontWeight="Medium" Foreground="{Binding SelectedRecordingDevice.State, Converter={StaticResource StateToBrush}}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock Text="HARDWARE DRIVER / ADAPTER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding SelectedRecordingDevice.AdapterName, FallbackValue='-'}"
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card B: Capture Controls & Status -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="18,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Engine Status Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CAPTURE ENGINE STATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="Real-Time WASAPI Listener" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                            </StackPanel>

                            <!-- Dynamic Engine State Badge -->
                            <Border Grid.Column="1" CornerRadius="12" Padding="12,4" VerticalAlignment="Center"
                                    Background="{StaticResource BrushCardBackgroundHover}" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CaptureState}" Value="Interrupted">
                                                        <Setter Property="Fill" Value="{StaticResource BrushWarning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CaptureState}" Value="Error">
                                                        <Setter Property="Fill" Value="{StaticResource BrushDanger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding CaptureStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Separator Grid.Row="1" Background="{StaticResource BrushSurfaceBorderSubtle}" Margin="0,0,0,14" />

                        <!-- Action Buttons -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Start Capture Button -->
                            <Button Grid.Column="0"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartCaptureCommand}"
                                    IsEnabled="{Binding CanStartCapture}"
                                    Height="36">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 0 0 L 10 6 L 0 12 Z" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Start Capture" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Stop Capture Button -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource OutlineButton}"
                                    Command="{Binding StopCaptureCommand}"
                                    IsEnabled="{Binding CanStopCapture}"
                                    Height="36">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Width="9" Height="9" Fill="{StaticResource BrushDanger}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Stop Capture" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT PANE: Live Audio Monitor & VU Meter (Card C) -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Monitor Header & Signal Detected Indicator -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LIVE AUDIO MONITOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="Peak &amp; RMS Signal Meter" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        </StackPanel>

                        <!-- Signal Detected Pill -->
                        <Border Grid.Column="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1E293B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSignal}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushSuccessBg}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSignal}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SignalStatusText}" FontSize="10" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSignal}" Value="True">
                                                    <Setter Property="Foreground" Value="#A7F3D0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Separator Grid.Row="1" Background="{StaticResource BrushSurfaceBorderSubtle}" Margin="0,0,0,16" />

                    <!-- Dual Channel VU Meters -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,18">
                        <!-- Left Channel (L) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="LEFT CHANNEL (L)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding FormattedLeftPeak}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource BrushTextPrimary}" />
                            </Grid>
                            <ProgressBar Grid.Row="1" Style="{StaticResource StudioMeterBarStyle}" Value="{Binding LeftMeterLevel}" />
                        </Grid>

                        <!-- Right Channel (R) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RIGHT CHANNEL (R)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding FormattedRightPeak}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource BrushTextPrimary}" />
                            </Grid>
                            <ProgressBar Grid.Row="1" Style="{StaticResource StudioMeterBarStyle}" Value="{Binding RightMeterLevel}" />
                        </Grid>

                        <!-- Meter Scale Legend (-60 dB to 0 dB) -->
                        <Grid Margin="2,2,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="-60 dB" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="-30 dB" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="-12 dB" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="-6 dB" FontSize="9" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="0 dB" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Stream Format & Buffer Health Box -->
                    <Border Grid.Row="3" Background="{StaticResource BrushSidebarBackground}" CornerRadius="6" Padding="14,12" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="INTERNAL FORMAT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Grid.Column="1" Text="48 kHz • 32-bit Float • Stereo" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushHdmi}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ENDPOINT SOURCE FORMAT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Grid.Column="1" Text="{Binding FormattedFormat}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                            </Grid>

                            <Separator Background="{StaticResource BrushSurfaceBorderSubtle}" Margin="0,0,0,8" />

                            <!-- Bounded Buffer Health -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RING BUFFER OCCUPANCY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Grid.Column="1" Text="{Binding FormattedBufferOccupancy}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource BrushTextPrimary}" />
                            </Grid>
                            <ProgressBar Style="{StaticResource BufferHealthBarStyle}" Value="{Binding BufferOccupancy}" Margin="0,0,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="BUFFER OVERFLOWS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Grid.Column="1" Text="{Binding BufferOverflows}" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{Binding BufferOverflows, Converter={StaticResource TypeToBrush}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Notice: Physical Routing Coming in Next Milestone -->
        <Border Grid.Row="3" Background="{StaticResource BrushSidebarBackground}" CornerRadius="6" Padding="14,8" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconOffline}" Fill="{StaticResource BrushSuccess}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Pure offline processing. Captured audio is buffered safely in memory without disk writing. Dual output routing to HDMI &amp; 3.5mm will activate in Milestone 03." FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
