<UserControl x:Class="DualSound.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DualSound.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="650" d:DesignWidth="980">

    <!-- Responsive minimal container without unnecessary scrolling on normal desktop screens -->
    <Grid Margin="28,20" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Application Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand, Title & Description -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DualSound" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                    <!-- Engine Status Indicator Badge -->
                    <Border Background="{StaticResource BrushCardBackgroundHover}" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EngineStatus}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Offline multi-device audio distributor for Windows 11" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
            </StackPanel>

            <!-- System Scan / Refresh Action -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource OutlineButton}"
                        Command="{Binding LoadDashboardCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                        Height="34" Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Scan System" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Busy / Scanning Banner -->
        <Border Grid.Row="1" Background="{StaticResource BrushAccentMuted}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding BusyMessage}" Foreground="#93C5FD" FontSize="12" FontWeight="Medium" />
            </StackPanel>
        </Border>

        <!-- 2. Audio Device Section: Two Main Output Cards (TV / HDMI & Home Theatre / 3.5 mm) -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: TV / HDMI -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#164E63" CornerRadius="6" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconHdmi}" Fill="{StaticResource BrushHdmi}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TV / HDMI Output" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Primary Video &amp; Ambient Channel" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>

                        <!-- Selection Status Badge -->
                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                Background="{StaticResource BrushAccentMuted}"
                                Visibility="{Binding IsHdmiSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Selected" Foreground="#93C5FD" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Separator Grid.Row="1" Background="{StaticResource BrushSurfaceBorderSubtle}" Margin="0,0,0,12" />

                    <!-- Device Selector Dropdown -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <TextBlock Text="ASSIGNED DEVICE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,5" />
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableHdmiDevices}"
                                  SelectedItem="{Binding SelectedHdmiDevice, Mode=TwoWay}"
                                  Height="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Device Properties Grid -->
                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Connection Type -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="CONNECTION TYPE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding SelectedHdmiDevice.DeviceTypeDescription, FallbackValue='Not identified'}"
                                       FontSize="12" FontWeight="Medium" Foreground="{Binding SelectedHdmiDevice.DeviceType, Converter={StaticResource TypeToBrush}}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Windows State -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="WINDOWS STATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding SelectedHdmiDevice.StateDescription, FallbackValue='No device'}"
                                       FontSize="12" FontWeight="Medium" Foreground="{Binding SelectedHdmiDevice.State, Converter={StaticResource StateToBrush}}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Driver Adapter -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="HARDWARE ADAPTER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding SelectedHdmiDevice.AdapterName, FallbackValue='-'}"
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- Connection Availability Footer -->
                    <Border Grid.Row="4" Background="{StaticResource BrushSidebarBackground}" CornerRadius="6" Padding="12,8" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Availability: " FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding HdmiConnectionAvailability}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Home Theatre / 3.5 mm -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="6" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconAudioJack}" Fill="{StaticResource BrushAnalog}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Home Theatre / 3.5 mm Output" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Surround &amp; Acoustic Bass Channel" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>

                        <!-- Selection Status Badge -->
                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                Background="{StaticResource BrushAccentMuted}"
                                Visibility="{Binding IsAnalogSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Selected" Foreground="#93C5FD" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Separator Grid.Row="1" Background="{StaticResource BrushSurfaceBorderSubtle}" Margin="0,0,0,12" />

                    <!-- Device Selector Dropdown -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <TextBlock Text="ASSIGNED DEVICE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,5" />
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableAnalogDevices}"
                                  SelectedItem="{Binding SelectedAnalogDevice, Mode=TwoWay}"
                                  Height="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Device Properties Grid -->
                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Connection Type -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="CONNECTION TYPE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding SelectedAnalogDevice.DeviceTypeDescription, FallbackValue='Not identified'}"
                                       FontSize="12" FontWeight="Medium" Foreground="{Binding SelectedAnalogDevice.DeviceType, Converter={StaticResource TypeToBrush}}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Windows State -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="WINDOWS STATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding SelectedAnalogDevice.StateDescription, FallbackValue='No device'}"
                                       FontSize="12" FontWeight="Medium" Foreground="{Binding SelectedAnalogDevice.State, Converter={StaticResource StateToBrush}}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Driver Adapter -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="HARDWARE ADAPTER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding SelectedAnalogDevice.AdapterName, FallbackValue='-'}"
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- Connection Availability Footer -->
                    <Border Grid.Row="4" Background="{StaticResource BrushSidebarBackground}" CornerRadius="6" Padding="12,8" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Availability: " FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding AnalogConnectionAvailability}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Default Audio Device Section -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="WINDOWS DEFAULT PLAYBACK DEVICE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding DefaultDevice.Name, FallbackValue='No default device detected'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />

                    <!-- Sample Rate & Channel Count -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sample Rate: " FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="{Binding DefaultDevice.FormattedSampleRate, FallbackValue='Unavailable'}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,16,0" />

                        <TextBlock Text="Channels: " FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="{Binding DefaultDevice.FormattedChannels, FallbackValue='Unavailable'}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Action to Audio Devices Page -->
                <Button Grid.Column="1" Style="{StaticResource OutlineButton}"
                        Command="{Binding NavigateToDevicesCommand}"
                        VerticalAlignment="Center" Height="32" Padding="14,0">
                    <TextBlock Text="Manage in Audio Devices" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>
