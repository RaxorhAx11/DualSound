<UserControl x:Class="DualSound.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DualSound.App.ViewModels"
             xmlns:enums="clr-namespace:DualSound.Contracts.Enums;assembly=DualSound.Contracts"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="700" d:DesignWidth="1020">

    <Grid Margin="24,18" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Application Header with Master Engine Action -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand, Title & Description -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DualSound" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                    <!-- Engine Status Indicator Badge -->
                    <Border Background="{StaticResource BrushCardBackgroundHover}" BorderBrush="{StaticResource BrushSurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding EngineStatus}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Simultaneous TV (HDMI) and Home Theatre (3.5 mm) audio processor" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Master Engine Start/Stop & Scan Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleEngineCommand}"
                        Height="36" Padding="18,0" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEngineRunning}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BrushDanger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EngineActionButtonText}" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource OutlineButton}"
                        Command="{Binding LoadDashboardCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                        Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Scan System" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Busy / Scanning Banner -->
        <Border Grid.Row="1" Background="{StaticResource BrushAccentMuted}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BusyMessage}" Foreground="#93C5FD" FontSize="12" FontWeight="Medium" />
        </Border>

        <!-- 2. Quick Sound Presets Bar -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="SOUND PRESET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                </StackPanel>

                <!-- Preset Buttons -->
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Movie Theatre" Height="28" Padding="12,0" Margin="0,0,6,0"
                            Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static enums:AudioPresetType.MovieTheatre}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePresetType}" Value="{x:Static enums:AudioPresetType.MovieTheatre}">
                                        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Dialogue Boost" Height="28" Padding="12,0" Margin="0,0,6,0"
                            Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static enums:AudioPresetType.DialogueBoost}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePresetType}" Value="{x:Static enums:AudioPresetType.DialogueBoost}">
                                        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Bass Boost" Height="28" Padding="12,0" Margin="0,0,6,0"
                            Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static enums:AudioPresetType.BassBoost}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePresetType}" Value="{x:Static enums:AudioPresetType.BassBoost}">
                                        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Night Mode" Height="28" Padding="12,0" Margin="0,0,6,0"
                            Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static enums:AudioPresetType.NightMode}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePresetType}" Value="{x:Static enums:AudioPresetType.NightMode}">
                                        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Balanced" Height="28" Padding="12,0" Margin="0,0,6,0"
                            Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static enums:AudioPresetType.Balanced}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePresetType}" Value="{x:Static enums:AudioPresetType.Balanced}">
                                        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Custom" Height="28" Padding="12,0" Margin="0,0,6,0"
                            Command="{Binding SelectPresetCommand}" CommandParameter="{x:Static enums:AudioPresetType.Custom}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivePresetType}" Value="{x:Static enums:AudioPresetType.Custom}">
                                        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 3. Dual Audio Device Output Cards: TV (HDMI) & Home Theatre (3.5 mm) -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: TV / HDMI -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#164E63" CornerRadius="6" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconHdmi}" Fill="{StaticResource BrushHdmi}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TV / HDMI Output" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Primary Video &amp; Ambient Soundtrack" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>

                        <!-- Selection Status Badge -->
                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                Background="{StaticResource BrushAccentMuted}"
                                Visibility="{Binding IsHdmiSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Selected" Foreground="#93C5FD" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Separator Grid.Row="1" Background="{StaticResource BrushSurfaceBorderSubtle}" Margin="0,0,0,10" />

                    <!-- Device Selector Dropdown -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="ASSIGNED PLAYBACK ENDPOINT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,5" />
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableHdmiDevices}"
                                  SelectedItem="{Binding SelectedHdmiDevice, Mode=TwoWay}"
                                  Height="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding DeviceTypeDescription}" FontSize="10" Foreground="{Binding DeviceType, Converter={StaticResource TypeToBrush}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Volume & Mute Controls -->
                    <Grid Grid.Row="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding ToggleTvMuteCommand}" Height="28" Padding="10,0" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                    <Setter Property="Content" Value="Mute" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTvMuted}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushDangerBg}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                            <Setter Property="Content" Value="MUTED" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding TvVolume, Mode=TwoWay}" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Text="{Binding TvVolume, StringFormat={}{0:P0}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Live VU Level Meters -->
                    <Border Grid.Row="4" Background="#0B0F19" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="6" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="LIVE OUTPUT LEVEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding FormattedTvPeak}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Left Bar -->
                            <ProgressBar Grid.Row="1" Minimum="0" Maximum="1" Value="{Binding TvMeterLevelLeft}" Height="4" Background="#1E293B" Foreground="{StaticResource BrushAccent}" BorderThickness="0" Margin="0,0,0,2" />
                            <!-- Right Bar -->
                            <ProgressBar Grid.Row="2" Minimum="0" Maximum="1" Value="{Binding TvMeterLevelRight}" Height="4" Background="#1E293B" Foreground="{StaticResource BrushAccent}" BorderThickness="0" />
                        </Grid>
                    </Border>

                    <!-- Availability Footer -->
                    <Border Grid.Row="5" Background="{StaticResource BrushSidebarBackground}" CornerRadius="6" Padding="10,6" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                        <TextBlock Text="{Binding HdmiConnectionAvailability}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Home Theatre / 3.5 mm -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="6" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconAudioJack}" Fill="{StaticResource BrushAnalog}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Home Theatre / 3.5 mm Output" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Enhanced Dialogue &amp; Acoustic Subwoofer" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>

                        <!-- Selection Status Badge -->
                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                Background="{StaticResource BrushAccentMuted}"
                                Visibility="{Binding IsAnalogSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Selected" Foreground="#93C5FD" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Separator Grid.Row="1" Background="{StaticResource BrushSurfaceBorderSubtle}" Margin="0,0,0,10" />

                    <!-- Device Selector Dropdown -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="ASSIGNED PLAYBACK ENDPOINT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,5" />
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding AvailableAnalogDevices}"
                                  SelectedItem="{Binding SelectedAnalogDevice, Mode=TwoWay}"
                                  Height="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding DeviceTypeDescription}" FontSize="10" Foreground="{Binding DeviceType, Converter={StaticResource TypeToBrush}}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Volume & Mute Controls -->
                    <Grid Grid.Row="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding ToggleHomeTheatreMuteCommand}" Height="28" Padding="10,0" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                    <Setter Property="Content" Value="Mute" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHomeTheatreMuted}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushDangerBg}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                            <Setter Property="Content" Value="MUTED" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding HomeTheatreVolume, Mode=TwoWay}" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Text="{Binding HomeTheatreVolume, StringFormat={}{0:P0}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Live VU Level Meters -->
                    <Border Grid.Row="4" Background="#0B0F19" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="6" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="LIVE OUTPUT LEVEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding FormattedHomeTheatrePeak}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Left Bar -->
                            <ProgressBar Grid.Row="1" Minimum="0" Maximum="1" Value="{Binding HomeTheatreMeterLevelLeft}" Height="4" Background="#1E293B" Foreground="{StaticResource BrushSuccess}" BorderThickness="0" Margin="0,0,0,2" />
                            <!-- Right Bar -->
                            <ProgressBar Grid.Row="2" Minimum="0" Maximum="1" Value="{Binding HomeTheatreMeterLevelRight}" Height="4" Background="#1E293B" Foreground="{StaticResource BrushSuccess}" BorderThickness="0" />
                        </Grid>
                    </Border>

                    <!-- Availability Footer -->
                    <Border Grid.Row="5" Background="{StaticResource BrushSidebarBackground}" CornerRadius="6" Padding="10,6" BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="1">
                        <TextBlock Text="{Binding AnalogConnectionAvailability}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Default Audio Device & Navigation Section -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="WINDOWS DEFAULT PLAYBACK ENDPOINT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding DefaultDevice.Name, FallbackValue='No default device detected'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                </StackPanel>

                <!-- Navigation Quick-Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding NavigateToEqualizerCommand}" Height="30" Padding="12,0" Margin="0,0,8,0">
                        <TextBlock Text="Adjust Equalizer &amp; Bass" />
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding NavigateToSyncCommand}" Height="30" Padding="12,0" Margin="0,0,8,0">
                        <TextBlock Text="Sync Delays" />
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding NavigateToDevicesCommand}" Height="30" Padding="12,0">
                        <TextBlock Text="All Devices" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
