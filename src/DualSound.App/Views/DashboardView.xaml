<UserControl x:Class="DualSound.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:DualSound.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="700" d:DesignWidth="950">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Top Header & Action -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="System Audio Overview" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="Real-time Windows audio endpoint status and hardware readiness" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding LoadDashboardCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Scan System" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Busy State Indicator -->
            <Border Background="{StaticResource BrushAccentMuted}" CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding BusyMessage}" Foreground="#93C5FD" FontSize="13" />
                </StackPanel>
            </Border>

            <!-- Target Hardware Setup Section -->
            <TextBlock Text="TARGET HARDWARE SETUP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- TV via HDMI Card -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#164E63" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconHdmi}" Fill="{StaticResource BrushHdmi}" Width="18" Height="18" Stretch="Uniform" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Primary Output: TV" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="HDMI / DisplayPort Audio" FontSize="12" Foreground="{StaticResource BrushHdmi}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Target device for video and ambient audio delivery." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding HdmiDevice.Name, FallbackValue='No HDMI endpoint currently active'}"
                                       FontWeight="Medium" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Status Badge -->
                        <Border Grid.Row="2" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"
                                Background="{Binding IsHdmiReady, Converter={StaticResource BoolToVis}, ConverterParameter=BrushSuccess}">
                            <TextBlock Text="{Binding IsHdmiReady, Converter={StaticResource BoolToVis}}" />
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"
                                    Background="{StaticResource BrushSuccessBg}"
                                    Visibility="{Binding IsHdmiReady, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Ready for HDMI Routing" Foreground="{StaticResource BrushSuccess}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"
                                    Background="{StaticResource BrushWarningBg}"
                                    Visibility="{Binding IsHdmiReady, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="HDMI Display Not Detected" Foreground="{StaticResource BrushWarning}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Home Theatre via 3.5mm Card -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#1E3A8A" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconAudioJack}" Fill="{StaticResource BrushAnalog}" Width="18" Height="18" Stretch="Uniform" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Secondary Output: Home Theatre" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="3.5 mm Analog Audio Jack" FontSize="12" Foreground="{StaticResource BrushAnalog}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Target device for surround sound and high-fidelity acoustics." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Analog35mmDevice.Name, FallbackValue='No 3.5mm analog endpoint active'}"
                                       FontWeight="Medium" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Status Badge -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"
                                    Background="{StaticResource BrushSuccessBg}"
                                    Visibility="{Binding Is35mmReady, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Ready for 3.5 mm Routing" Foreground="{StaticResource BrushSuccess}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"
                                    Background="{StaticResource BrushWarningBg}"
                                    Visibility="{Binding Is35mmReady, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="3.5 mm Jack Not Connected" Foreground="{StaticResource BrushWarning}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Current Windows Default Playback Device -->
            <TextBlock Text="WINDOWS DEFAULT PLAYBACK ENDPOINT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />
            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="{StaticResource BrushAccentMuted}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="DEFAULT PLAYBACK" Foreground="#93C5FD" FontSize="10" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="{Binding DefaultDevice.DeviceTypeDescription}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>

                        <TextBlock Text="{Binding DefaultDevice.Name, FallbackValue='None'}" FontSize="17" FontWeight="Bold" Margin="0,0,0,6" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Audio Specification: " Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                            <TextBlock Text="{Binding DefaultDevice.FormattedAudioFormat, FallbackValue='Unknown'}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Medium" FontSize="12" Margin="0,0,16,0" />

                            <TextBlock Text="Hardware Adapter: " Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                            <TextBlock Text="{Binding DefaultDevice.AdapterName, FallbackValue='Unknown'}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                        </StackPanel>

                        <TextBlock Text="{Binding DefaultDevice.Id}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontFamily="Consolas" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Command="{Binding NavigateToDevicesCommand}">
                        <TextBlock Text="Manage Devices" />
                    </Button>
                </Grid>
            </Border>

            <!-- Discovered Endpoint Categories Summary Grid -->
            <TextBlock Text="ENDPOINT BREAKDOWN BY CONNECTION TYPE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Active -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" />
                        <TextBlock Text="{Binding ActiveEndpointsCount}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="Ready for output" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </Border>

                <!-- HDMI -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="HDMI / DP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushHdmi}" />
                        <TextBlock Text="{Binding HdmiEndpointsCount}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="Digital display" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </Border>

                <!-- 3.5mm -->
                <Border Grid.Column="4" Style="{StaticResource CardPanel}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="3.5mm / ANALOG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAnalog}" />
                        <TextBlock Text="{Binding AnalogEndpointsCount}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="Jack / Speakers" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </Border>

                <!-- USB -->
                <Border Grid.Column="6" Style="{StaticResource CardPanel}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="USB AUDIO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushUsb}" />
                        <TextBlock Text="{Binding UsbEndpointsCount}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="External DAC/Card" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </Border>

                <!-- Virtual -->
                <Border Grid.Column="8" Style="{StaticResource CardPanel}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="VIRTUAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushVirtual}" />
                        <TextBlock Text="{Binding VirtualEndpointsCount}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="Software bridges" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Active Devices Quick List -->
            <TextBlock Text="CURRENT ACTIVE PLAYBACK DEVICES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />
            <Border Style="{StaticResource CardPanel}" Padding="0">
                <ItemsControl ItemsSource="{Binding ActiveDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BrushSurfaceBorderSubtle}" BorderThickness="0,0,0,1" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Circle -->
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{StaticResource BrushSuccess}" Margin="0,0,12,0" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                            <Border Background="{StaticResource BrushAccentMuted}" CornerRadius="3" Padding="4,1" Margin="8,0,0,0"
                                                    Visibility="{Binding IsDefaultPlayback, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="DEFAULT" Foreground="#93C5FD" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding FormattedAudioFormat}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="4" Padding="8,4" Background="{StaticResource BrushCardBackgroundHover}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeviceTypeDescription}" Foreground="{Binding DeviceType, Converter={StaticResource TypeToBrush}}" FontSize="11" FontWeight="Medium" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

