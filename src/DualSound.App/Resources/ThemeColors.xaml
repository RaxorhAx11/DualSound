<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme Colors -->
    <Color x:Key="ColorAppBackground">#0B0F19</Color>
    <Color x:Key="ColorSidebarBackground">#111827</Color>
    <Color x:Key="ColorHeaderBackground">#111827</Color>
    <Color x:Key="ColorCardBackground">#182032</Color>
    <Color x:Key="ColorCardBackgroundHover">#1F2942</Color>
    <Color x:Key="ColorSurfaceBorder">#273349</Color>
    <Color x:Key="ColorSurfaceBorderSubtle">#1F2A3D</Color>

    <!-- Text Colors -->
    <Color x:Key="ColorTextPrimary">#F9FAFB</Color>
    <Color x:Key="ColorTextSecondary">#9CA3AF</Color>
    <Color x:Key="ColorTextMuted">#6B7280</Color>

    <!-- Accent & Status Colors -->
    <Color x:Key="ColorAccent">#3B82F6</Color>
    <Color x:Key="ColorAccentHover">#2563EB</Color>
    <Color x:Key="ColorAccentMuted">#1E3A8A</Color>
    <Color x:Key="ColorSuccess">#10B981</Color>
    <Color x:Key="ColorSuccessBg">#064E3B</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorWarningBg">#78350F</Color>
    <Color x:Key="ColorDanger">#EF4444</Color>
    <Color x:Key="ColorDangerBg">#7F1D1D</Color>

    <!-- Device Type Accents -->
    <Color x:Key="ColorHdmi">#06B6D4</Color>
    <Color x:Key="ColorAnalog">#3B82F6</Color>
    <Color x:Key="ColorUsb">#A855F7</Color>
    <Color x:Key="ColorBluetooth">#6366F1</Color>
    <Color x:Key="ColorVirtual">#EAB308</Color>
    <Color x:Key="ColorUnknown">#94A3B8</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushAppBackground" Color="{StaticResource ColorAppBackground}" />
    <SolidColorBrush x:Key="BrushSidebarBackground" Color="{StaticResource ColorSidebarBackground}" />
    <SolidColorBrush x:Key="BrushHeaderBackground" Color="{StaticResource ColorHeaderBackground}" />
    <SolidColorBrush x:Key="BrushCardBackground" Color="{StaticResource ColorCardBackground}" />
    <SolidColorBrush x:Key="BrushCardBackgroundHover" Color="{StaticResource ColorCardBackgroundHover}" />
    <SolidColorBrush x:Key="BrushSurfaceBorder" Color="{StaticResource ColorSurfaceBorder}" />
    <SolidColorBrush x:Key="BrushSurfaceBorderSubtle" Color="{StaticResource ColorSurfaceBorderSubtle}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushAccentMuted" Color="{StaticResource ColorAccentMuted}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushSuccessBg" Color="{StaticResource ColorSuccessBg}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushWarningBg" Color="{StaticResource ColorWarningBg}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushDangerBg" Color="{StaticResource ColorDangerBg}" />

    <SolidColorBrush x:Key="BrushHdmi" Color="{StaticResource ColorHdmi}" />
    <SolidColorBrush x:Key="BrushAnalog" Color="{StaticResource ColorAnalog}" />
    <SolidColorBrush x:Key="BrushUsb" Color="{StaticResource ColorUsb}" />
    <SolidColorBrush x:Key="BrushBluetooth" Color="{StaticResource ColorBluetooth}" />
    <SolidColorBrush x:Key="BrushVirtual" Color="{StaticResource ColorVirtual}" />
    <SolidColorBrush x:Key="BrushUnknown" Color="{StaticResource ColorUnknown}" />

</ResourceDictionary>
